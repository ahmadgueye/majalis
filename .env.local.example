# Copie ce fichier en .env.local et remplis-le avec les valeurs de ton projet Supabase
# (Project Settings → API). La clé publique ("publishable" ou "anon") peut être exposée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
