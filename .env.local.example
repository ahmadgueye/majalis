# Copie ce fichier en .env.local.
# Les valeurs ci-dessous pointent sur Supabase local (npm run db:start) : ce sont les clés
# de développement par défaut de la CLI, identiques pour tout le monde, donc sans danger.
# Pour le projet en ligne, remplace-les par les valeurs de Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Clé secrète (jamais exposée au navigateur) : utilisée seulement par la sauvegarde quotidienne.
# En local : la valeur SECRET_KEY affichée par « npx supabase status » ;
# en ligne : Project Settings → API Keys → Secret key. Jamais dans le dépôt.
SUPABASE_SECRET_KEY=
# Mot de passe de la tâche quotidienne (/api/cron/sauvegarde). En ligne : une longue valeur aléatoire.
CRON_SECRET=dev-sauvegarde

# En ligne seulement : couper les cercles et les séances, pas encore prêts.
# NEXT_PUBLIC_CERCLES=off

# Sauvegarde vers Google Drive (facultatif, voir docs/mise-en-ligne.md ; jeton : npm run drive:token).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
